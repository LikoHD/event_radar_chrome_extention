{
  "name": "埋点大师-查看网站上报数据埋点-EventRadar",
  "version": "1.1.4",
  "description": "优雅展示网页埋点上报信息，支持搜索、过滤、复制",
  "manifest_version": 3,
  "permissions": [
    "webRequest",
    "scripting",
    "activeTab",
    "sidePanel",
    "clipboardWrite",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "world": "MAIN",
      "js": [
        "ab-probe.js"
      ]
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "js": [
        "ab-bridge.js"
      ]
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "all_frames": true,
      "js": [
        "content-script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Event Radar",
    "default_icon": {
      "16": "images/icon16.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
    }
  },
  "icons": {
    "16": "images/icon16.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "panel.html",
        "panel.css",
        "panel.js",
        "analytics-core.js",
        "platform-catalog.js",
        "platform-adapters.js",
        "ab-panel.js",
        "ai-settings.js",
        "ab-panel.css",
        "ab-core.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "minimum_chrome_version": "111",
  "options_page": "ai-settings.html"
}
